{
  "name": "vocabulary-knowledge-cards-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "evidence:audit": "node scripts/evidence-pipeline.mjs audit",
    "evidence:build-cards": "node scripts/evidence-pipeline.mjs build-cards",
    "evidence:ingest": "node scripts/evidence-pipeline.mjs ingest",
    "evidence:inventory": "node scripts/evidence-pipeline.mjs inventory",
    "evidence:migrate": "node scripts/evidence-pipeline.mjs migrate",
    "evidence:record-review": "node scripts/evidence-pipeline.mjs record-review",
    "evidence:rebuild": "pnpm evidence:ingest && pnpm evidence:scan && pnpm evidence:inventory && pnpm evidence:migrate && pnpm evidence:build-cards && pnpm rebuild:primary-graph && pnpm evidence:audit",
    "evidence:scan": "node scripts/evidence-pipeline.mjs scan",
    "rebuild:primary-graph": "node scripts/rebuild-primary-graph.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@antv/g6": "5.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
